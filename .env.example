# 复制成 .env，填自己的值。不要把 .env 提交进仓库。

# ── 模型（任意 OpenAI 兼容接口）──
LLM_BASE=https://api.deepseek.com/v1
LLM_KEY=
LLM_MODEL=deepseek-chat

# 可选：同供应商的备用模型（逗号分隔），主模型 429 / 空回复时依次尝试
LLM_FALLBACK_MODELS=

# 可选：换一家做兜底
LLM_FALLBACK_BASE=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=

# 免费档常限并发：设 1 会在本地排队，排不上就跳下一环
LLM_CONCURRENCY=
LLM_TIMEOUT=45
LLM_QUEUE_WAIT=4
# 推理型模型会先想一大段，把短回答截成空串；默认关闭思考
LLM_THINKING=0

# ── 审批人（逗号分隔的学号，2 字母 + 5 位数字）──
REVIEWERS=uc00001

# ── 限额（每人每小时；只防手滑，不是安全机制）──
ASK_LIMIT_PER_HOUR=10
ASK_BASIC_LIMIT_PER_HOUR=20

# ── 学期前缀（B 类知识会加这个前缀）──
ACADEMIC_YEAR=2026/27

# ── 检索阈值（BM25 分数，低于此值走兜底）──
MIN_SCORE=2.5

# ── 可选：开放数据平台（ICTO 之类），没有就留空 ──
OPEN_DATA_KEY=
